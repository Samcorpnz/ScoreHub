{
  "name": "scorehub",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "relay",
    "bridge",
    "packages/db",
    "packages/types"
  ],
  "dependencies": {
    "react": "^19",
    "react-dom": "^19",
    "eslint": "^9"
  },
  "scripts": {
    "dev:relay": "npm run dev --workspace=relay",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build:relay": "npm run build --workspace=relay",
    "build:frontend": "npm run build --workspace=frontend",
    "db:migrate": "npm run migrate --workspace=packages/db",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=frontend",
    "test:e2e:critical": "npm run test:e2e:critical --workspace=frontend",
    "test:e2e:full-sports": "npm run test:e2e:full-sports --workspace=frontend",
    "scan:sonar": "bash scripts/sonar-scan.sh",
    "postinstall": "node scripts/patch-postcss-cve-2026-41305.js"
  },
  "overrides": {
    "@prisma/dev": "0.24.16",
    "deepmerge-ts": "^8.0.0",
    "sharp": ">=0.35.5",
    "postcss": "^8.5.23",
    "next": {
      "postcss": "^8.5.23"
    },
    "ws": ">=8.21.0",
    "qs": ">=6.16.0",
    "js-yaml": ">=4.3.2 <5.0.0",
    "form-data": ">=4.0.6",
    "fast-uri": ">=3.1.6 <4.0.0",
    "mysql2": ">=3.24.0",
    "ip-address": ">=10.4.0",
    "socket.io-parser": ">=4.2.7",
    "undici": ">=7.29.0 <8.0.0",
    "valibot": ">=1.4.2",
    "http-cache-semantics": ">=4.3.0 <5.0.0",
    "global-agent": "^4.1.3",
    "react": "^19",
    "react-dom": "^19",
    "eslint": {
      ".": "^9",
      "minimatch": {
        "brace-expansion": ">=1.1.17 <2.0.0"
      }
    },
    "minimatch@10.2.5": {
      "brace-expansion": ">=5.0.8 <6.0.0"
    }
  },
  "allowScripts": {
    "@prisma/client@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true
  }
}

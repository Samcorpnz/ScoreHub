{
  "name": "scorehub-bridge",
  "version": "0.1.0",
  "description": "Venue-side serial bridge — reads Saturn console, pushes to cloud relay",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc && cp -r src/ui/public dist/ui/public",
    "start": "node dist/index.js",
    "electron:dev": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "test": "jest",
    "test:coverage": "jest --coverage --coverageReporters=lcov --coverageReporters=text-summary"
  },
  "dependencies": {
    "@sentry/node": "^10.62.0",
    "express": "^5.2.1",
    "node-fetch": "^3.3.2",
    "puppeteer": "^25.9.0",
    "serialport": "^13.0.0",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/node-fetch": "^2.6.13",
    "@types/supertest": "^7.2.1",
    "electron": "44.4.1",
    "electron-builder": "^26.15.3",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "author": "ScoreHub",
  "build": {
    "appId": "co.nz.scorehub.bridge",
    "productName": "ScoreHub Bridge",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [],
    "mac": {
      "category": "public.app-category.sports",
      "icon": "resources/icon.png",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ]
    },
    "win": {
      "icon": "resources/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}

{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022"],
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*"],
  // Tests are type-checked by ts-jest at test time. Keeping them out of the
  // build also keeps them out of dist/ (and the packaged installer), and lets
  // contract tests import the relay's schemas from outside rootDir.
  "exclude": ["src/**/__tests__/**"]
}

{
  "name": "@scorehub/stream-deck-plugin",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "package": "node build.mjs && rm -f ../frontend/public/scorehub.streamDeckPlugin && zip -r -X -q ../frontend/public/scorehub.streamDeckPlugin com.scorehub.sdPlugin -x '*.DS_Store'"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.2",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}

{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "cd .. && npm run build --workspace=packages/db && cd frontend && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts --grep-invert @full-sports",
    "test:e2e:ui": "playwright test --ui --config=e2e/playwright.config.ts",
    "test:e2e:full-sports": "playwright test --config=e2e/playwright.config.ts --grep @full-sports"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@logtail/next": "^0.4.0",
    "@scorehub/db": "*",
    "@scorehub/types": "*",
    "@sentry/nextjs": "^10.71.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.1",
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "bcryptjs": "^3.0.3",
    "form-data": "^4.0.6",
    "jose": "^6.2.9",
    "mailgun.js": "^14.0.0",
    "next": "^16.3.3",
    "next-auth": "5.0.0-beta.32",
    "react": "^19",
    "react-dom": "^19",
    "socket.io-client": "^4.8.3",
    "stripe": "^22.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}

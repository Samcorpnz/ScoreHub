NEXT_PUBLIC_RELAY_URL=https://your-relay.fly.dev

# Postgres connection string (Neon) — accounts, orgs, matches
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth — generate with: openssl rand -hex 32
# Must match the relay's AUTH_SECRET exactly — the relay verifies
# control-panel tokens minted by /api/control-token with this same secret.
AUTH_SECRET=change-this-to-a-long-random-string
# Also used by lib/webauthn.ts (SA-108 passkeys) to derive WebAuthn's rpID
# (hostname) and expectedOrigin — no separate env var needed.
NEXTAUTH_URL=https://app.scorehub.co.nz

# Users now sign up via /signup — no more AUTH_USERS env var.

# Stripe billing (SA-23) — secret key from the Stripe dashboard, webhook
# signing secret from `stripe listen` (dev) or the dashboard's webhook
# endpoint config (prod), and the Price IDs for the Pro/Venue plan objects.
# The publishable key is exposed to the browser (NEXT_PUBLIC_) — it's how
# Stripe.js mounts the embedded checkout form in the control panel's Billing tab.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_VENUE=price_...
STRIPE_PRICE_ID_PRO_ANNUAL=price_...
STRIPE_PRICE_ID_VENUE_ANNUAL=price_...
# Graphics Operator add-on (requires Pro or Venue) — see Account.addOns /
# relay/src/entitlements.ts requireAddOn("graphics-operator").
STRIPE_PRICE_ID_GRAPHICS=price_...
STRIPE_PRICE_ID_GRAPHICS_ANNUAL=price_...
# Data Feed add-on (requires Pro or Venue) — bridges a physical console or a
# third-party graphics engine over the relay's authenticated data-feed
# route/socket role. See Account.addOns / requireAddOn("data-feed") and
# relay/src/auth.ts's verifyDataFeedSecret.
STRIPE_PRICE_ID_DATA_FEED=price_...
STRIPE_PRICE_ID_DATA_FEED_ANNUAL=price_...

# Email (Mailgun) — used to send the new-email verification link
# (frontend/app/api/account/email/route.ts), org invitations
# (frontend/app/api/orgs/[orgId]/invitations/route.ts), payment-failed
# notices (frontend/app/api/billing/webhook/route.ts), signup confirmation
# (frontend/app/api/signup/route.ts) and password reset
# (frontend/app/api/auth/forgot-password/route.ts). API key and sending
# domain from the Mailgun dashboard. EMAIL_FROM must be an address on
# MAILGUN_DOMAIN (e.g. "ScoreHub <noreply@scorehub.co.nz>").
MAILGUN_API_KEY=key-...
MAILGUN_DOMAIN=mail.scorehub.co.nz
EMAIL_FROM=ScoreHub <noreply@scorehub.co.nz>

# E2E_EXPOSE_AUTH_TOKENS — local/e2e only (set by docker-compose.yml), never
# in .env.vercel.production or .env.vercel.preview. Makes /api/signup and
# /api/auth/forgot-password return the raw confirmation/reset token in the
# JSON response instead of emailing it, so Playwright (no real inbox) can
# complete those flows. See frontend/lib/e2eTestMode.ts.
# E2E_EXPOSE_AUTH_TOKENS=true

# Cloudflare Turnstile — bot protection on the public /signup and
# /forgot-password endpoints (both send email on every valid POST, so an
# unprotected endpoint is an email-bombing vector). Create a widget at
# https://dash.cloudflare.com/?to=/:account/turnstile for localhost/127.0.0.1
# plus your production domain. Both vars are optional: unset, Turnstile is
# skipped entirely (see lib/turnstile.ts and app/components/TurnstileWidget.tsx).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...
TURNSTILE_SECRET=0x...

# Sentry (SA-28) — error tracking. Optional: unset in dev/self-hosted, no-op
# when absent. NEXT_PUBLIC_SENTRY_DSN is exposed to the browser (client-side
# errors); SENTRY_DSN covers server/edge runtimes. Same DSN value for both
# is fine — use the frontend project's DSN from the Sentry dashboard.
NEXT_PUBLIC_SENTRY_DSN=https://...@o0.ingest.us.sentry.io/0
SENTRY_DSN=https://...@o0.ingest.us.sentry.io/0
# Build-time only — lets `withSentryConfig` (next.config.js) upload source
# maps so production/preview stack traces aren't minified. Optional: build
# silently skips source map upload when unset. Generate at sentry.io →
# Settings → Auth Tokens, scope: project:releases, org: samcorp-limited.
SENTRY_AUTH_TOKEN=sntrys_...
# Runtime, read-only — powers app/api/health/sentry-error-rate (SA-48's free
# alternative to Better Stack's paid Sentry connector; see
# infra/betterstack/README.md). Different token/scope than SENTRY_AUTH_TOKEN
# above: needs org:read + project:read + event:read, not project:releases.
# Optional: unset disables the check and the route fails open (always ok).
SENTRY_ERROR_MONITOR_TOKEN=sntrys_...
SENTRY_ORG_SLUG=samcorp-limited
SENTRY_ERROR_RATE_PROJECTS=scorehub-relay,scorehub-frontend
SENTRY_ERROR_RATE_THRESHOLD=20

# Better Stack (Logtail) — structured application/security-event logging,
# shipped directly from app code via @logtail/next rather than a Vercel log
# drain (log drains need Vercel Pro; this team is on Hobby). Optional: unset
# in dev, no-op. Var names are what @logtail/next itself reads (see
# node_modules/@logtail/next/dist/platform/generic.js) — do not rename.
# Source + token created under Samcorp Limited → Your team in the Better
# Stack dashboard ("ScoringApp Frontend (Vercel)").
BETTER_STACK_SOURCE_TOKEN=...
BETTER_STACK_INGESTING_URL=https://s0000000.eu-central-1a.betterstackdata.com

# Support requests (SA-121) — /api/support/case files them in the Jira
# Service Management "SUP" service desk. JSM_EMAIL is the Atlassian account
# that files them; JSM_API_TOKEN is an API token for it (id.atlassian.com →
# Security → API tokens). Unset means the case form answers 503 and tells
# people to email instead.
JSM_BASE_URL=https://samcorp.atlassian.net
JSM_SERVICE_DESK_ID=1
JSM_EMAIL=
JSM_API_TOKEN=

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Tenant / billing boundary. One paying customer.
model Account {
  id                   String   @id @default(uuid())
  name                 String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  plan                 String   @default("free")
  billingInterval      String?
  // Add-on purchases orthogonal to `plan` (e.g. "graphics-operator") — see
  // requireAddOn() in relay/src/entitlements.ts. A plain string array is the
  // pragmatic choice while there's a single add-on; revisit as a proper
  // join model if/when several independent add-ons exist.
  addOns               String[] @default([])
  // Legacy: add-ons used to bill on their own Stripe subscription, one column
  // per add-on (see ADDON_SUBSCRIPTION_FIELD in frontend/lib/plans.ts). They
  // are now items on the base plan's stripeSubscriptionId, so the customer
  // gets one invoice. These stay set only for accounts not yet moved over by
  // frontend/scripts/migrate-addon-subscriptions.ts; drop them once none are.
  graphicsSubscriptionId String?
  dataFeedSubscriptionId String?
  // Add-ons removed from the subscription that stay usable until the period
  // already paid for runs out, at addOnsEndAt. Stripe has no per-item
  // cancel-at-period-end, so the item is removed straight away (without a
  // refund) and access is ended here, by the renewal webhook.
  addOnsEnding         String[] @default([])
  addOnsEndAt          DateTime?
  // Set the first time a plan-upgrade discount (see UPGRADE_DISCOUNT_COUPON_ID
  // in frontend/lib/plans.ts) is applied to this account, so the offer can't
  // be re-triggered by downgrading and upgrading again.
  upgradeDiscountUsedAt DateTime?
  createdAt            DateTime @default(now())

  orgs Org[]
}

// Tracks processed Stripe webhook event IDs so a Stripe-initiated retry of an
// already-handled event can't double-apply a plan change.
model StripeEvent {
  id          String   @id
  processedAt DateTime @default(now())
}

enum OrgType {
  FEDERATION
  REGION
  CLUB
  TEAM
}

// Hierarchical unit within an account, e.g. a federation with regional/club/team
// sub-orgs. Most accounts will have exactly one Org; federation customers nest them.
model Org {
  id          String   @id @default(uuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  parentOrgId String?
  parent      Org?     @relation("OrgHierarchy", fields: [parentOrgId], references: [id])
  children    Org[]    @relation("OrgHierarchy")
  orgType     OrgType  @default(CLUB)
  name        String
  createdAt   DateTime @default(now())

  matches     Match[]
  memberships Membership[]
  tokens      ScopedToken[]
  invitations Invitation[]
  players     Player[]

  @@index([accountId])
  @@index([parentOrgId])
}

enum MatchStatus {
  SCHEDULED
  LIVE
  ENDED
}

// Replaces the relay's in-memory singleton match state. `state` mirrors the
// relay's MatchState shape verbatim (kept as Json so the relay's TypeScript
// type stays the single source of truth for the score-state schema).
// sport/competition/homeName/visitorName are mirrored out of `state` onto
// real columns purely so the matches list can filter/sort without querying
// into JSON — `state` remains the source of truth the relay reads/writes.
model Match {
  id          String      @id @default(uuid())
  orgId       String
  org         Org         @relation(fields: [orgId], references: [id])
  state       Json
  status      MatchStatus @default(LIVE)
  sport       String?
  competition String?
  homeName    String?
  visitorName String?
  scheduledAt DateTime?
  createdAt   DateTime    @default(now())
  endedAt     DateTime?
  // Required alongside matchId on every /display/* URL, GET /state, and the
  // viewer socket join once DISPLAY_TOKEN_REQUIRED is set (relay/src/server.ts)
  // — a bare org id is guessable/shareable, this isn't. Auto-generated at
  // match creation so opening a display link stays a zero-config action;
  // regenerable via POST /api/orgs/[orgId]/matches/[matchId]/rotate-display-token
  // if a link leaks. Nullable only until the backfill migration populates
  // existing rows, then a follow-up migration makes it NOT NULL.
  displayToken String? @unique

  tokens ScopedToken[]
  events MatchEvent[]

  @@index([orgId, status])
  @@index([orgId, sport])
  @@index([orgId, competition])
}

// A match's event log — one row per thing that happened (score, period
// change, clock start/stop), written by the relay as it happens. `seq` is a
// plain autoincrement, so it orders events within a match and doubles as the
// `since` cursor for GET /api/data-feed/events. `data` holds the rest of the
// MatchEvent shape (packages/types) as Json for the same reason Match.state
// is Json: the relay's TypeScript type stays the single source of truth.
model MatchEvent {
  seq     BigInt   @id @default(autoincrement())
  matchId String
  match   Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  type    String
  at      DateTime
  data    Json

  @@index([matchId, seq])
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  name            String
  // Null for users created before terms-of-service tracking was added.
  // New users (self-serve signup or invite-accept) always set both.
  termsAcceptedAt DateTime?
  termsVersion    String?
  createdAt       DateTime  @default(now())

  memberships           Membership[]
  emailChangeRequests   EmailChangeRequest[]
  invitationsSent       Invitation[]
  passwordResetRequests PasswordResetRequest[]
  authenticators        Authenticator[]
  webauthnChallenges    WebAuthnChallenge[]
}

// Single-use pending request to create a brand-new account (self-serve
// sign-up), same tokenHash+expiresAt+consumedAt shape as
// Invitation/EmailChangeRequest. termsAcceptedAt/termsVersion are captured
// here (when the checkbox was actually checked) and copied onto the
// resulting User once the request is consumed, rather than recording
// consent at confirm-time. Expiry is 24h — shorter than Invitation's 7 days
// since this is the requester's own inbox, not a third party's.
model SignupRequest {
  id              String    @id @default(uuid())
  email           String
  name            String
  orgName         String
  tokenHash       String    @unique
  termsAcceptedAt DateTime
  termsVersion    String
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([email])
}

// Single-use pending password reset, mirroring EmailChangeRequest's shape
// and 1h expiry (same "must still have access to the inbox right now"
// reasoning).
model PasswordResetRequest {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Single-use pending request for changing a User's email. Only the hashed
// token is stored (the raw token only ever appears in the emailed link,
// matching ScopedToken.tokenHash's approach). consumedAt (rather than
// deleting on success) keeps "already used" distinguishable from "not
// found"/expired.
model EmailChangeRequest {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  newEmail   String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// A registered WebAuthn credential ("passkey"), SA-108. Additive to
// passwordHash — most users have both a password and 1+ passkeys, so this
// is never the account's sole auth factor and passwordHash on User stays
// required. credentialId/publicKey/transports are stored base64url-encoded
// (the shape @simplewebauthn/server hands back) rather than raw bytes, to
// avoid Bytes-vs-Buffer friction with the "prisma-client" (not
// prisma-client-js) generator in use here.
model Authenticator {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  credentialId String    @unique
  publicKey    String
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  deviceType   String
  backedUp     Boolean   @default(false)
  name         String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

// Single-use WebAuthn challenge, mirroring PasswordResetRequest/
// EmailChangeRequest's tokenHash+expiresAt shape but keyed on the raw
// challenge (base64url) itself rather than a hash, since the challenge is
// not a secret credential — it's sent to the browser/authenticator by
// design and its only job is anti-replay. userId is null for the
// usernameless login flow (we don't know who's authenticating until after
// the credential is looked up); it's set for registration since that
// endpoint is auth-gated. Short TTL (~5 min) since it's a synchronous
// in-flight ceremony, not an email link — deleted (not just marked
// consumed) on successful verify.
model WebAuthnChallenge {
  id        String   @id @default(uuid())
  challenge String   @unique
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  purpose   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum Role {
  ADMIN
  MANAGER
  OPERATOR
  VIEWER
}

// RBAC scaffolding: which orgs a user belongs to and what they can do there.
model Membership {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id])
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())

  @@unique([userId, orgId])
  @@index([orgId])
}

// Single-use pending invitation for a person to join an Org. Only the hashed
// token is stored, mirroring EmailChangeRequest.tokenHash's approach. Expiry
// is 7 days (longer than EmailChangeRequest's 1h) since invitees often don't
// have an account yet and may not see the email immediately.
model Invitation {
  id          String    @id @default(uuid())
  orgId       String
  org         Org       @relation(fields: [orgId], references: [id])
  email       String
  role        Role
  tokenHash   String    @unique
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id])
  expiresAt   DateTime
  consumedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([orgId])
  @@index([email])
}

enum ScopedTokenType {
  BRIDGE
  CONTROL
  GRAPHICS
  DATA_FEED
}

// Per-org credential for headless devices (the bridge) that can't do an
// interactive NextAuth login. Only the hash is stored; the plaintext is
// shown once at creation time.
// matchId pins a bridge device to one match (venues running several
// courts/games concurrently each get their own bridge); null keeps the
// pre-existing org-wide behavior.
model ScopedToken {
  id         String          @id @default(uuid())
  orgId      String
  org        Org             @relation(fields: [orgId], references: [id])
  matchId    String?
  match      Match?          @relation(fields: [matchId], references: [id])
  type       ScopedTokenType
  tokenHash  String          @unique
  label      String?
  createdAt  DateTime        @default(now())
  revokedAt  DateTime?

  @@index([orgId])
  @@index([matchId])
}

// Graphics Operator add-on roster entry — org-wide (not per-sport/competition
// per product decision), so the same person's photo/bio is reused across all
// their teams. externalId/provider join a live graphicsFeed player stat
// (keyed by the provider's own player id) to this record; a player with no
// match here just renders without a photo, never blocks the stat itself.
model Player {
  id          String   @id @default(uuid())
  orgId       String
  org         Org      @relation(fields: [orgId], references: [id])
  externalId  String?
  provider    String?
  firstName   String
  lastName    String
  displayName String?
  photoUrl    String?
  bio         String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([orgId, provider, externalId])
  @@index([orgId])
}

// Durable security/compliance audit trail — failed auth attempts, permission
// denials, rate-limit trips, and admin actions (invites, role changes, token
// issuance/revocation). Deliberately has no FK relations to User/Org/Account:
// an audit record must survive deletion of the thing it describes, and a
// failed-auth event often has no resolvable userId/orgId at all (bad token,
// unknown email). orgId/accountId/userId/actor are therefore plain nullable
// columns, populated best-effort. eventType is a free-form dot-namespaced
// string (e.g. "auth.failure", "permission.denied", "token.revoked") rather
// than an enum, since new event types will be added far more often than this
// migration-heavy schema wants to churn — see Account.plan for the same
// pragmatic string-over-enum call.
model AuditLog {
  id        String   @id @default(uuid())
  eventType String
  accountId String?
  orgId     String?
  userId    String?
  // Human-readable identifier of the actor when there's no userId to point
  // to — an attempted email address, a token label, an IP. Never a secret.
  actor     String?
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([accountId, createdAt])
  @@index([eventType, createdAt])
}

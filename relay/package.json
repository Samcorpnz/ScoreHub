{
  "name": "scorehub-relay",
  "version": "1.0.0",
  "description": "Cloud relay — receives from bridge, broadcasts to viewers",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:remote": "DOTENV_CONFIG_PATH=.env.remote ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:coverage": "jest --coverage --coverageReporters=lcov --coverageReporters=text-summary"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "@logtail/node": "^0.5.8",
    "@scorehub/db": "*",
    "@scorehub/types": "*",
    "@sentry/node": "^10.62.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "dompurify": "^3.4.14",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.9",
    "jsdom": "^30.1.0",
    "multer": "^2.4.0",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/dompurify": "^3.2.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}

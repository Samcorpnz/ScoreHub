PORT=4000

# `npm run dev` loads `.env` — keep DATABASE_URL/REDIS_URL/R2_* out of it so
# plain local dev stays sandboxed (in-memory legacy mode, no real Neon/
# Upstash/R2 access). To point at real hosted dev infra instead, copy this
# file to `.env.remote` (gitignored) with those fields filled in, and run
# `npm run dev:remote`. docker-compose.yml is the other safe local-DB path
# (local Postgres/Redis containers, no cloud accounts needed at all).

# Legacy/dev-only fallback secrets — only used when DATABASE_URL is unset
# (local dev, tests). Once DATABASE_URL is set, the relay requires real
# per-org bridge tokens and signed control JWTs instead (see src/auth.ts).
BRIDGE_SECRET=change-this-to-a-long-random-string
CONTROL_SECRET=change-this-to-a-different-long-random-string

# Comma-separated list of origins allowed to call this relay via CORS
# (e.g. the frontend's deployed URL). Required — there is no wildcard
# fallback, so requests from unlisted origins are rejected.
ALLOWED_ORIGINS=http://localhost:3000

# Postgres connection string (Neon) for tenant-scoped match persistence
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Must match the frontend's AUTH_SECRET exactly — used to verify
# control-panel tokens minted by the frontend's /api/control-token route.
AUTH_SECRET=change-this-to-a-long-random-string

# Optional. Upstash Redis (or any Redis) connection string, used for the
# Socket.io cross-instance adapter and the clock tick-lock so multiple relay
# instances can run behind a load balancer (SA-62/SA-19). Omitting this
# preserves today's single-instance, in-memory-only behavior.
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# Optional. Cloudflare R2 (S3-compatible) + CDN for logo/sound uploads
# (SA-64/SA-27). All five must be set together to enable it — omitting any
# one falls back to today's local-disk UPLOAD_DIR behavior, so dev/self-hosted
# and the Jest suite are unaffected.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=scorehub-uploads
R2_PUBLIC_URL=https://cdn.scorehub.app

# Optional. Sentry error tracking (SA-28) — no-op when unset.
SENTRY_DSN=https://...@o0.ingest.us.sentry.io/0

# Optional. Legacy/dev-only fallback secret for the Data Feed add-on's
# authenticated persona (verifyDataFeedSecret in src/auth.ts) — same
# non-mandatory pattern as GRAPHICS_SECRET; only consulted when DATABASE_URL
# is unset. Left unset, legacy-mode data-feed auth always fails closed.
DATA_FEED_SECRET=change-this-to-a-long-random-string

# Optional. Gates GET /health/deep (SA-109), the internal-only
# Postgres/Redis reachability + active-match-count check consumed by the
# Better Stack monitor in infra/betterstack/. Left unset, that route always
# 401s rather than becoming a public info-leak/DoS surface.
DEEP_HEALTH_SECRET=change-this-to-a-long-random-string

# Optional, defaults to false. Enforces the per-match displayToken on
# GET /state and the viewer socket join (see the Match.displayToken schema
# comment in packages/db/prisma/schema.prisma). Leave unset/false until every
# existing /display/* link in production has had time to be regenerated with
# a token — see docs/ or the rollout note in src/server.ts.
DISPLAY_TOKEN_REQUIRED=false

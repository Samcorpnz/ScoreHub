{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scorehub-downloads",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-14",
  "vars": {
    "GITHUB_REPO": "Samcorpnz/ScoreHub",
    "RELEASE_TAG_PREFIX": "bridge-v"
  },
  "routes": [
    { "pattern": "downloads.scorehub.co.nz", "custom_domain": true }
  ],
  // Secret, set per environment and not stored here: GITHUB_TOKEN, a read-only
  // token for the release lookup (npx wrangler secret put GITHUB_TOKEN [--env uat]).
  "observability": {
    "enabled": true
  },
  "env": {
    "uat": {
      "name": "scorehub-downloads-uat",
      // Only downloads.uat serves this Worker; no stray *.workers.dev or preview URL.
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "downloads.uat.scorehub.co.nz", "custom_domain": true }
      ],
      // UAT serves bridge-uat-v* pre-releases (SA-255), never production builds.
      "vars": {
        "GITHUB_REPO": "Samcorpnz/ScoreHub",
        "RELEASE_TAG_PREFIX": "bridge-uat-v",
        "INCLUDE_PRERELEASE": "true"
      }
    }
  }
}
